DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meeting_processor
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production

# -----------------------------------------------------------------------------
# Yandex OAuth (primary, visible in UI)
# -----------------------------------------------------------------------------
# Create app at https://oauth.yandex.ru
#   Platform: Web services
#   Callback URI: http://localhost:8000/api/v1/auth/yandex/callback
#   Scopes: login:email, login:info
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/api/v1/auth/yandex/callback

# Comma-separated list of allowed corporate email domains for Yandex login.
# Leave empty to allow ANY Yandex account (dev/testing only — DO NOT use in production).
ALLOWED_EMAIL_DOMAINS=company.ru

# -----------------------------------------------------------------------------
# Bitrix24 OAuth (kept functional but disabled in UI)
# -----------------------------------------------------------------------------
# To enable: fill these in and show the Bitrix24 login button in
# frontend/src/pages/LoginPage.vue (currently gated by a feature flag).
# Requires a paid Bitrix24 plan to create a local application.
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_DOMAIN=
BITRIX24_REDIRECT_URI=http://localhost:8000/api/v1/auth/bitrix24/callback

# -----------------------------------------------------------------------------
# LLM settings
# -----------------------------------------------------------------------------
# Default provider: "openai" or "ollama". Users can override per-account in Settings.
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama (local LLM server — install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3

WHISPER_MODEL=large-v3
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
